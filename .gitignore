# =====================================
# 운영용 배포 환경용 .gitignore
# 스택: TypeScript & Next.js
# =====================================

# ---------------------
# Node dependencies
# ---------------------
/node_modules
/.pnp
.pnp.*
/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------
# Build output
# ---------------------
# Next.js 빌드 폴더
/.next/
# Next.js export output
/out/
# 일반 빌드 폴더
/build

# ---------------------
# Testing
# ---------------------
/coverage

# ---------------------
# Misc
# ---------------------
.DS_Store
# 인증서 파일
*.pem

# ---------------------
# Debug logs
# ---------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------
# Environment files
# ---------------------
# 필요 시 커밋 가능
.env*

# ---------------------
# Vercel deployment
# ---------------------
.vercel

# ---------------------
# TypeScript
# ---------------------
*.tsbuildinfo
next-env.d.ts

# ---------------------
# Markdown files (ignore docs)
# ---------------------
*.md